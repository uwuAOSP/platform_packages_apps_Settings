<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/app_jump_target_rule_header_title">
        <com.android.settingslib.widget.AppPreference
            android:key="app_jump_target_rule_header"
            android:selectable="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/app_jump_target_rules_title">
        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="app_jump_target_rule_inherit"
            android:summary="@string/app_jump_target_rule_inherit_summary"
            android:title="@string/app_jump_pair_mode_inherit_title" />

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="app_jump_target_rule_always_allow"
            android:summary="@string/app_jump_target_rule_allow_summary"
            android:title="@string/app_jump_pair_mode_allow_title" />

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="app_jump_target_rule_ask"
            android:summary="@string/app_jump_target_rule_ask_summary"
            android:title="@string/app_jump_pair_mode_ask_title" />

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="app_jump_target_rule_always_block"
            android:summary="@string/app_jump_target_rule_block_summary"
            android:title="@string/app_jump_pair_mode_block_title" />
    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="app_jump_target_rule_footer" />
</androidx.preference.PreferenceScreen>
